# Specify Data File Path

csv_file_path = "cox_ph_heart_failure_survival.csv"

# Specify Column Roles and Names

time_column = "time_months"
event_column = "death"

numeric_covariates = [
    "age",
    "bmi",
    "systolic_bp",
    "ejection_fraction",
    "nyha_class"
]

binary_covariates = [
    "sex",
    "diabetes",
    "smoker",
    "chronic_kidney_disease",
    "beta_blocker"
]

# Load Data

df = pd.read_csv(csv_file_path)

# Data Cleaning

# Convert Boolean and binary variables to 0/1

for col in binary_covariates:

    if df[col].dtype == "object":

        df[col] = (
            df[col].astype(str)
            .str.strip()
            .str.lower()
            .isin(["true", "1", "yes", "male"])
            .astype(int)
        )

# Select model variables

model_df = df[
    [time_column, event_column]
    + numeric_covariates
    + binary_covariates
]

model_df = model_df.dropna()

# Fit Cox Proportional Hazards Model

cph = CoxPHFitter()

cph.fit(
    model_df,
    duration_col=time_column,
    event_col=event_column
)

# Results

cph.print_summary(decimals=3)


# Plot: Hazard Ratios (Forest Plot)

fig, ax = plt.subplots(figsize=(8, 6))

cph.plot(hazard_ratios=True, ax=ax)

ax.axvline(1, color="gray", linestyle="--")

ax.set_title(
    "Cox PH Model: Hazard Ratios (95% CI)",
    fontsize=16
)

ax.set_ylabel("Covariates", fontsize=12)
ax.set_xlabel("Hazard Ratio", fontsize=12)

plt.tight_layout()

# Save Plot

plt.savefig("cox_hazard_ratios.png", dpi=300)

# Display Plot

plt.show()


# the ending of the run
print("\nSurvival Analysis Completed!")

