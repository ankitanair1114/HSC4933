# Imports

import matplotlib.pyplot as plt
import pandas as pd

from lifelines import KaplanMeierFitter, CoxPHFitter
from lifelines.statistics import logrank_test

# Specify Data File Path

csv_file_path = "km_logrank_readmission.csv"

# Specify Column Names

time_column = "time_days"
event_column = "readmitted"
group_column = "treatment_group"

# Load Data

df = pd.read_csv(csv_file_path)

# Initialize the fitter

kmf = KaplanMeierFitter()
fig, ax = plt.subplots(figsize=(10, 6))

# Plot Curves and Perform Log-Rank Test

for group_name, group_df in df.groupby(group_column):

    kmf.fit(
        durations=group_df[time_column],
        event_observed=group_df[event_column],
        label=f"Group: {group_name}",
    )

    kmf.plot_survival_function(ax=ax, show_censors=True)


# Separate treatment groups

group_true = df[df[group_column] == "Standard care"]
group_false = df[df[group_column] == "Telehealth follow-up"]

# Perform log-rank test

logrank_result = logrank_test(
    durations_A=group_true[time_column],
    durations_B=group_false[time_column],
    event_observed_A=group_true[event_column],
    event_observed_B=group_false[event_column],
)

# Display Results

print("\nLog-Rank Test: Treatment Groups")
print(f"n (Standard care) = {len(group_true)}")
print(f"n (Telehealth follow-up) = {len(group_false)}")
print(f"Test statistic = {logrank_result.test_statistic:.4f}")
print(f"p-value = {logrank_result.p_value:.4g}")


# Plot Formatting

plt.title("Kaplan-Meier Survival: Treatment Groups", fontsize=16)
plt.xlabel("Time (Days)", fontsize=12)
plt.ylabel("Readmission-Free Survival Probability", fontsize=12)
plt.xlim(0, 180)
plt.ylim(0, 1.05)
plt.grid(True, linestyle="--", alpha=0.6)
plt.legend(loc="lower left")
plt.tight_layout()

# Save Plot

plt.savefig("kaplan_meier_treatment.png", dpi=300)

# Display Plot

plt.show()

fig, ax = plt.subplots(figsize=(10, 6))

# Plot Curves

for group_name, group_df in df.groupby("sex"):

    kmf.fit(
        durations=group_df[time_column],
